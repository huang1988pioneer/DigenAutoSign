<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DigenAutoSign.Desktop.MainWindow"
        Title="Digen Auto Sign"
        Width="1000" Height="860"
        MinWidth="1000" MinHeight="860"
        Background="#F4F7F6">
  <Window.Styles>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="24"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#5F736F"/>
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#B9D5D1"/>
      <Setter Property="Padding" Value="13,10"/>
      <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#1A4A47"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#067B75"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="17,10"/>
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="244,*">
    <Border Background="#0E302F" Padding="25">
      <StackPanel Spacing="20">
        <StackPanel Spacing="6">
          <TextBlock Text="Digen Auto Sign" FontSize="24" FontWeight="Bold" Foreground="White"/>
          <TextBlock Text="自動簽到控制台" Foreground="#A8D0CB"/>
          <TextBlock Text="管理登入狀態、GitHub Actions 與每日簽到結果。"
                     TextWrapping="Wrap" FontSize="12" Foreground="#8FB8B3" Margin="0,8,0,0"/>
        </StackPanel>

        <Border Background="#1A5350" CornerRadius="10" Padding="14">
          <StackPanel Spacing="6">
            <TextBlock Text="安全提醒" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock Text="登入、OTP 與 CAPTCHA 必須由你在瀏覽器中完成。此工具只會從本機 profile 讀取 Token 並複製到剪貼簿。"
                       TextWrapping="Wrap" FontSize="12" Foreground="#C5E3DF"/>
          </StackPanel>
        </Border>

        <StackPanel Spacing="5">
          <Button Classes="nav" Click="DashboardNavButton_OnClick">簽到總覽</Button>
          <Button Classes="nav" Click="AccountsNavButton_OnClick">帳號設定</Button>
          <Button Classes="nav" Click="LoginNavButton_OnClick">更新登入狀態</Button>
        </StackPanel>

        <TextBlock Text="排程：台灣時間 05:05、08:00、11:00、13:05、21:05（GitHub Actions，33 帳號依序錯開 5–15 秒）"
                   TextWrapping="Wrap" FontSize="12" Foreground="#8FB8B3" Margin="0,18,0,0"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1" Margin="38,34,24,24" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="650" Spacing="18">

        <!-- Dashboard -->
        <StackPanel x:Name="DashboardView" Spacing="18">
          <TextBlock Text="簽到總覽" FontSize="30" FontWeight="SemiBold" Foreground="#12312F"/>
          <TextBlock Classes="muted"
                     Text="手動執行每日簽到，並讀取最近一次 Digen Daily Reward 的完成狀態。"
                     TextWrapping="Wrap"/>
          <Border Classes="panel">
            <StackPanel Spacing="18">
              <TextBlock Text="GitHub Actions 儀表板" FontSize="20" FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="TriggerButton" Classes="primary" Click="TriggerButton_OnClick">立即執行簽到</Button>
                <Button x:Name="RefreshButton" Click="RefreshButton_OnClick">更新執行結果</Button>
              </StackPanel>
              <Grid ColumnDefinitions="*,*">
                <StackPanel Spacing="4" Margin="0,0,24,0">
                  <TextBlock Classes="muted" Text="本機別名帳號" FontSize="12"/>
                  <TextBlock x:Name="ConfiguredMetric" Text="—" FontSize="20" FontWeight="SemiBold" Foreground="#067B75"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Classes="muted" Text="最近執行" FontSize="12"/>
                  <TextBlock x:Name="RunMetric" Text="尚未讀取" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*">
                <StackPanel Spacing="4" Margin="0,0,24,0">
                  <TextBlock Classes="muted" Text="上次成功 Action" FontSize="12"/>
                  <TextBlock x:Name="LastSuccessActionMetric" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="#067B75"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Classes="muted" Text="上次失敗 Action" FontSize="12"/>
                  <TextBlock x:Name="LastFailureActionMetric" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="#B44D4D"/>
                </StackPanel>
              </Grid>
              <Border Height="1" Background="#D5E3E0"/>
              <Grid ColumnDefinitions="*,*">
                <StackPanel Spacing="4" Margin="0,0,24,0">
                  <TextBlock Classes="muted" Text="連續成功 Action 天數" FontSize="12"/>
                  <TextBlock x:Name="MonthlyStreakMetric" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="#067B75"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Classes="muted" Text="完成時間" FontSize="12"/>
                  <TextBlock x:Name="RunTimeMetric" Text="—" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="DashboardStatus" Classes="muted"
                         Text="執行後可在 GitHub Actions 檢視各帳號的成功、失敗與未設定狀態。"
                         TextWrapping="Wrap"/>
              <TextBlock Text="最近一次執行明細（含帳號 action 歷史）" FontSize="16" FontWeight="SemiBold"/>
              <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="MonthlyAccountsPanel" Spacing="7"/>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Accounts -->
        <StackPanel x:Name="AccountsView" IsVisible="False" Spacing="18">
          <TextBlock Text="帳號設定" FontSize="30" FontWeight="SemiBold" Foreground="#12312F"/>
          <TextBlock Classes="muted"
                     Text="名稱會保存在本機，並寫入 accounts.json 供登入腳本使用；同時對應 DIGEN_TOKEN1–33。"
                     TextWrapping="Wrap"/>
          <Border Classes="panel">
            <StackPanel Spacing="12">
              <TextBlock Text="帳號別名" FontSize="19" FontWeight="SemiBold"/>
              <ScrollViewer MaxHeight="410">
                <StackPanel x:Name="AliasPanel" Spacing="8"/>
              </ScrollViewer>
              <Button HorizontalAlignment="Left" Click="SaveAliasesButton_OnClick">儲存本機別名</Button>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Login / export token -->
        <StackPanel x:Name="LoginView" IsVisible="False" Spacing="18">
          <TextBlock Text="更新登入狀態" FontSize="30" FontWeight="SemiBold" Foreground="#12312F"/>
          <TextBlock Classes="muted"
                     Text="瀏覽器開啟後完成 Digen 登入，再關閉瀏覽器；工具會從本機 profile 讀取 digen_token 並供你複製到 GitHub Secret。建議順序：chrome → 被 Google 擋時改選 edge 備案 → 仍不行再選 firefox（各瀏覽器使用獨立 profile）。"
                     TextWrapping="Wrap"/>
          <Border Classes="panel">
            <StackPanel Spacing="14">
              <TextBlock Text="選擇帳號" FontSize="19" FontWeight="SemiBold"/>
              <ComboBox x:Name="AccountComboBox" Width="280" SelectedIndex="0"
                        SelectionChanged="AccountComboBox_OnSelectionChanged"/>
              <Border Background="#E6F2F0" CornerRadius="7" Padding="12,8">
                <TextBlock x:Name="SecretNameText" FontFamily="Consolas,Cascadia Mono,monospace" Foreground="#076861"/>
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <ComboBox x:Name="BrowserComboBox" Width="120" SelectedIndex="0"
                          SelectionChanged="BrowserComboBox_OnSelectionChanged"/>
                <Button x:Name="StartLoginButton" Classes="primary" Click="StartLoginButton_OnClick">開始登入並匯出</Button>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="CopyTokenButton" IsEnabled="False" Click="CopyTokenButton_OnClick">複製 Digen Token</Button>
                <Button x:Name="CopySecretButton" Click="CopySecretButton_OnClick">複製 Secret 名稱</Button>
              </StackPanel>
              <Border Height="1" Background="#D5E3E0" Margin="0,4"/>
              <TextBlock Text="本機 profile" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock x:Name="ProfileStatus" Classes="muted"
                         Text="選擇帳號後可建立或更新對應的本機瀏覽器 profile。"
                         TextWrapping="Wrap"/>
              <TextBlock x:Name="LoginStatus" Classes="muted"
                         Text="Token 不會寫入設定檔或執行紀錄；請直接貼到對應的 GitHub Repository Secret。"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
